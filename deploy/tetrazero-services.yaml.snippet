# Snippet for TetrazeroDashboard — cloudflared explicit hostname (not Caddy).
# Already applied in cloudflared/config.yml on this host:
#
#   - hostname: fuzzing.tetrazero.com
#     service: http://127.0.0.1:9310
#
# Deploy: cd /home/william/TetrazeroDashboard && ./scripts/deploy-cloudflared.sh
# UI stays local-only on :9300.

  clusterfuzz:
    label: ClusterFuzz (local)
    path: /home/william/Documents/clusterfuzz/deploy
    compose_files: [docker-compose.yml]
    autostart: false
    port: 9300
    group: infrastructure
    notes: >-
      UI :9300 local-only. Webhooks 127.0.0.1:9310 via fuzzing.tetrazero.com
      (explicit cloudflared ingress). Do not start compose cloudflared.
