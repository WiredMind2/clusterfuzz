# Self-hosted GitHub Actions runner for ClusterFuzz local PR fuzzing.
# Based on myoung34/github-runner with docker.sock for sibling builds.
#
# Prefer docker-compose.runner.yml + runner.env; build this image only if you
# need extra host packages baked in (clang, zip, etc.).

FROM myoung34/github-runner:ubuntu-noble

USER root
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      clang \
      llvm \
      libclang-rt-18-dev \
      zip \
      python3 \
      python3-venv \
      python3-pip \
      ca-certificates \
      curl \
      git \
      sudo \
    && rm -rf /var/lib/apt/lists/*

# Keep default entrypoint from upstream image (registers + runs the agent).
