# cloudflared for fuzzing.tetrazero.com — copy to cloudflared.env
#   cp cloudflared.env.example cloudflared.env
# Never commit cloudflared.env or credentials.json.
#
# Preferred: create a Cloudflare Tunnel token that routes
#   fuzzing.tetrazero.com → http://127.0.0.1:9310
# Then only TUNNEL_TOKEN is required (Compose uses `tunnel run --token`).
#
TUNNEL_TOKEN=

# Alternative (config-file mode): leave TUNNEL_TOKEN empty and mount
# github-app/cloudflared-config.yml + credentials.json (see docs/github-app.md).
