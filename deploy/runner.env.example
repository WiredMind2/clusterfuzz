# Copy to runner.env and fill in values (never commit runner.env).
#
# Registration options (pick one):
#   A) Short-lived RUNNER_TOKEN from GitHub UI or:
#        gh api -X POST repos/OWNER/REPO/actions/runners/registration-token --jq .token
#   B) Longer-lived PAT as ACCESS_TOKEN (recommended for restarts):
#        classic PAT: repo admin (or fine-grained: Administration=Read/Write on runners)
#
# Scope:
#   Now (pilot): RUNNER_SCOPE=repo + REPO_URL for one target (e.g. AnimeManager)
#   Later (N repos): RUNNER_SCOPE=org + ORG_NAME=… so one gha-runner serves all
#   Personal repos without an org: one registration per repo, or create an org
#
# See docs/multi-repo.md

# Required for repo-scoped runner:
REPO_URL=https://github.com/WiredMind2/AnimeManager

# Option A — registration token (expires ~1h; mint again on re-register):
# RUNNER_TOKEN=

# Option B — PAT that can mint registration tokens at container start:
#   classic: repo scope with admin on the target repo
#   fine-grained: Repository permissions → Administration = Read and write
#   (without Administration, GitHub returns 403 on registration-token)
ACCESS_TOKEN=

# Optional overrides:
RUNNER_NAME=clusterfuzz-local-runner
RUNNER_SCOPE=repo
# ORG_NAME=
LABELS=self-hosted,linux,clusterfuzz-local
