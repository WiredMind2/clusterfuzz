# Copy to runner.env and fill in values (never commit runner.env).
#
# Registration options (pick one):
#   A) Short-lived RUNNER_TOKEN from GitHub UI or:
#        gh api -X POST repos/OWNER/REPO/actions/runners/registration-token --jq .token
#        (org) gh api -X POST orgs/ORG/actions/runners/registration-token --jq .token
#   B) Longer-lived PAT as ACCESS_TOKEN (recommended for restarts):
#        classic PAT: repo admin (or fine-grained: Administration=Read/Write on runners)
#        for org runners: also need admin:org / org self-hosted runners permission
#
# Scope:
#   Personal account (WiredMind2 today): RUNNER_SCOPE=repo + REPO_URL=https://github.com/WiredMind2/clusterfuzz
#     Multi-repo is via repository_dispatch into this repo (see docs/multi-repo.md).
#   GitHub Organization: RUNNER_SCOPE=org + ORG_NAME=… so one runner is shared natively;
#     allow the runner group for member repos in org Settings → Actions → Runners.
#
# See docs/multi-repo.md

# Required for repo-scoped runner (personal-account / central-dispatch mode):
REPO_URL=https://github.com/WiredMind2/clusterfuzz

# Required for org-scoped runner:
# RUNNER_SCOPE=org
# ORG_NAME=your-org
# REPO_URL can be omitted for org scope

# Option A — registration token (expires ~1h; mint again on re-register):
# RUNNER_TOKEN=

# Option B — PAT that can mint registration tokens at container start:
#   classic: repo scope with admin on the target repo (and admin:org for org runners)
#   fine-grained: Repository permissions → Administration = Read and write
#   (without Administration, GitHub returns 403 on registration-token)
ACCESS_TOKEN=

# Optional overrides:
RUNNER_NAME=clusterfuzz-local-runner
RUNNER_SCOPE=repo
# ORG_NAME=
LABELS=self-hosted,linux,clusterfuzz-local
