# Optional env for llm-fuzz-worker (copy to llm-worker.env; never commit secrets).
# GITHUB_TOKEN=ghp_...   # repo pull-requests:write for follow-up comments
#
# Provider: ollama (default) or openrouter
# LLM_FUZZ_PROVIDER=ollama
# LLM_FUZZ_MODEL=Qwen2.5-Coder:1.5b
# LLM_FUZZ_BASE_URL=http://127.0.0.1:11434
#
# OpenRouter:
# LLM_FUZZ_PROVIDER=openrouter
# LLM_FUZZ_MODEL=qwen/qwen-2.5-coder-7b-instruct
# LLM_FUZZ_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-...
#
# LLM_FUZZ_BG_SECONDS=600
