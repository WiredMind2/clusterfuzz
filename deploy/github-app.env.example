# ClusterFuzz GitHub App (Sourcery-style PR fuzz) — copy to github-app.env
#   cp github-app.env.example github-app.env
# Never commit github-app.env or the private key PEM.

# From GitHub App settings (https://github.com/settings/apps)
GITHUB_APP_ID=
# Optional (not required by the worker; useful for docs/scripts)
# GITHUB_APP_CLIENT_ID=
# Path to the downloaded private key (mounted or absolute on host)
GITHUB_APP_PRIVATE_KEY_PATH=/opt/clusterfuzz/deploy/github-app/private-key.pem
# Webhook secret you set when creating the App
GITHUB_APP_WEBHOOK_SECRET=

# Listen (localhost; cloudflared terminates TLS for fuzzing.tetrazero.com)
GITHUB_APP_BIND=127.0.0.1
GITHUB_APP_PORT=9310

# Job queue + workdirs under shared data/
GITHUB_APP_QUEUE_DIR=/data/github_app_queue
GITHUB_APP_WORK_DIR=/data/github_app_work
GITHUB_APP_DENY_LIST=/opt/clusterfuzz/deploy/github-app/deny-repos.txt

# Timed fuzz defaults
FUZZ_SECONDS=60
FUZZ_ENGINE=auto
CLUSTERFUZZ_UI_URL=http://127.0.0.1:9300
LOCAL_GCS_ROOT=/data/local_gcs
SKIP_INGEST=

# LLM assist (fail-open if Ollama down)
LLM_FUZZ_ENABLED=1
LLM_FUZZ_BASE_URL=http://127.0.0.1:11434
LLM_FUZZ_MODEL=Qwen2.5-Coder:1.5b
LLM_FUZZ_TIMEOUT_S=45
LLM_FUZZ_BG_ENABLED=0

# Max concurrent fuzz jobs (others wait in queue)
GITHUB_APP_MAX_WORKERS=1
